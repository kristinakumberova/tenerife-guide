---
import { Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { organization, vacationRental } from "../lib/jsonld";
import heroImg from "../assets/apartman/hero-terasa-sunset.webp";

// Reálná homepage (SPEC-Lite §1 / chunk 4): value prop + rozcestník Apartmán/Průvodce.
// Vizuální audit 2026-06-22 (P1/1): hero varianta B — atmosférická fotka na pozadí +
// dvě cesty jako karty přes foto. Canonical = / (vlastní).
const cards = [
  {
    href: "/paradise/apartman/",
    eyebrow: "Ubytování",
    title: "Jazuma Paradise",
    text: "Studio pro 4 hosty s výhledem na moře v Costa Adeje. Fotky, dostupnost a všechno praktické k pobytu na jednom místě.",
    cta: "Prohlédnout apartmán",
  },
  {
    href: "/paradise/guide/",
    eyebrow: "Průvodce",
    title: "Tenerife Guide",
    text: "Ověřená místa na jihu i po celém ostrově — mapa, výlety, doprava a tipy na jídlo pro hosty apartmánu.",
    cta: "Otevřít průvodce",
  },
];
---

<BaseLayout
  title="Jazuma Paradise — apartmán a průvodce, Tenerife"
  description="Apartmán Jazuma Paradise v Costa Adeje na Tenerife a praktický průvodce pro hosty: mapa míst, doprava, jídlo a rychlé kontakty."
  jsonLd={[organization(), vacationRental()]}
  breadcrumb={[{ name: "Domů", url: "/" }]}
>
  <section class="hero-b hero-b-home">
    <div class="hero-b-media">
      <Picture
        src={heroImg}
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        widths={[480, 768, 1086, 1600]}
        sizes="(max-width: 900px) 100vw, 1200px"
        alt="Terasa apartmánu Jazuma Paradise při západu slunce s výhledem na moře a Costa Adeje"
        fetchpriority="high"
        loading="eager"
      />
    </div>
    <div class="hero-b-content">
      <p class="eyebrow eyebrow-on-photo">Jazuma Living</p>
      <h1>Apartmán a průvodce po Tenerife</h1>
      <p class="hero-b-lead">
        Soukromý apartmán v Costa Adeje na jihu Tenerife a praktický průvodce, který hostům
        pomůže s příjezdem, výlety, dopravou i rychlými kontakty.
      </p>
      <div class="pathway-cards">
        {
          cards.map((card) => (
            <a class="pathway-card" href={card.href}>
              <p class="eyebrow">{card.eyebrow}</p>
              <h2>{card.title}</h2>
              <p class="pathway-card-text">{card.text}</p>
              <span class="pathway-card-cta">
                {card.cta}
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
