---
// Karta restaurace. Port z legacy/src/components/RestaurantCard.tsx.
// Statické, 0 JS — lucide ikony nahrazeny inline SVG, confidenceLabel inline.
interface Photo {
  url?: string;
  width?: number | null;
  height?: number | null;
  objectPosition?: string | null;
  alt?: string;
  license?: string;
  credit?: string;
}
interface Restaurant {
  name: string;
  kristinasNote: string;
  practical?: { note?: string };
  tags: string[];
  confidence: "H" | "M" | "L";
  links: { official?: string };
  photos?: Photo[];
}

interface Props {
  restaurant: Restaurant;
}

const { restaurant } = Astro.props;
const photo = restaurant.photos?.find((p) => p.url);
// Jednotný rámeček 3:2 pro všechny karty (vizuální konzistence mřížky). Kde střed
// ořízne to podstatné, řeší se přes photo.objectPosition (viz build-data focal map).

const confidenceLabel = (value: string) =>
  value === "H" ? "Ověřeno" : value === "M" ? "Ověřit aktuálnost" : "Ověřit před cestou";
---

<article class:list={["restaurant-card", { "restaurant-card-photo": photo }]}>
  {
    photo ? (
      <div class="restaurant-photo">
        <img
          src={photo.url}
          alt={photo.alt ?? restaurant.name}
          loading="lazy"
          decoding="async"
          width={photo.width ?? 600}
          height={photo.height ?? 400}
          style={photo.objectPosition ? `object-position:${photo.objectPosition}` : undefined}
        />
      </div>
    ) : (
      <div class="icon-pill">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2" />
          <path d="M7 2v20" />
          <path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7" />
        </svg>
      </div>
    )
  }
  <h3>{restaurant.name}</h3>
  <p>{restaurant.kristinasNote}</p>
  {restaurant.practical?.note && <p class="muted clamp">{restaurant.practical.note}</p>}
  <div class="chip-row compact">
    {restaurant.tags.slice(0, 4).map((tag) => <span class="badge">{tag}</span>)}
    <span class={`confidence confidence-${restaurant.confidence.toLowerCase()}`}>
      {confidenceLabel(restaurant.confidence)}
    </span>
  </div>
  {
    restaurant.links.official && (
      <a class="text-button" href={restaurant.links.official} target="_blank" rel="noreferrer">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M15 3h6v6" />
          <path d="M10 14 21 3" />
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h6" />
        </svg>
        Web
      </a>
    )
  }
  {photo?.credit && <p class="photo-credit">{photo.credit}</p>}
</article>
