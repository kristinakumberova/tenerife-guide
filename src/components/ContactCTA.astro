---
// mailto, ne formulář (rozhodnuto 2026-06-18). Compact = jen WhatsApp (header).
interface Props {
  label?: string;
  whatsappUrl?: string;
  phone?: string;
  email?: string;
  variant?: "primary" | "compact" | "emergency";
}

const {
  label = "Napiš zprávu",
  whatsappUrl = "https://wa.me/420702188376",
  phone = "+420 702 188 376",
  email,
  variant = "primary",
} = Astro.props;

const className =
  variant === "compact" ? "btn btn-ghost" : variant === "emergency" ? "btn btn-danger" : "btn btn-primary";
const telHref = `tel:${phone.replace(/\s/g, "")}`;
---

<div class="contact-cta">
  <a class={className} href={whatsappUrl} target="_blank" rel="noreferrer">
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
    </svg>
    <span>{label}</span>
  </a>
  {
    email && variant !== "compact" && (
      <a class="phone-link" href={`mailto:${email}`}>
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect width="20" height="16" x="2" y="4" rx="2" />
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
        </svg>
        <span>{email}</span>
      </a>
    )
  }
  {
    variant !== "compact" && (
      <a class="phone-link" href={telHref}>
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
        <span>{phone}</span>
      </a>
    )
  }
</div>
