---
// Rychlá info karta (hero apartmánu). Port z legacy/src/components/QuickInfoCard.tsx.
// Statické, 0 JS — lucide ikony nahrazeny inline SVG.
interface Props {
  title: string;
  summary: string;
  status?: "neutral" | "contact-required";
  href?: string;
}

const { title, summary, status = "neutral", href } = Astro.props;
const warn = status === "contact-required";
---

<article class={`quick-card${warn ? " quick-card-warn" : ""}`}>
  {
    warn ? (
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect width="18" height="12" x="3" y="10" rx="2" />
        <circle cx="12" cy="16" r="1" />
        <path d="M7 10V7a5 5 0 0 1 10 0v3" />
      </svg>
    ) : (
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
        <polyline points="22 4 12 14.01 9 11.01" />
      </svg>
    )
  }
  <div>
    <h3>{title}</h3>
    <p>
      {
        href ? (
          <a href={href} target="_blank" rel="noreferrer">
            {summary}
          </a>
        ) : (
          summary
        )
      }
    </p>
  </div>
</article>
