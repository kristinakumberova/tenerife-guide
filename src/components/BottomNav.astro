---
const path = Astro.url.pathname;
const tabs = [
  { to: "/paradise/apartman/", label: "Apartmán", icon: "home" },
  { to: "/paradise/guide/", label: "Guide", icon: "map" },
  { to: "/paradise/doprava/", label: "Doprava", icon: "car" },
  { to: "/paradise/stravovani/", label: "Jídlo", icon: "utensils" },
  { to: "/paradise/kontakty/", label: "Kontakty", icon: "phone" },
] as const;

const isActive = (to: string) => path === to || path.startsWith(to);
---

<nav class="bottom-nav" aria-label="Mobilní navigace">
  {
    tabs.map((tab) => (
      <a href={tab.to} class={isActive(tab.to) ? "active" : undefined}>
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          {tab.icon === "home" && (
            <>
              <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
              <polyline points="9 22 9 12 15 12 15 22" />
            </>
          )}
          {tab.icon === "map" && (
            <>
              <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21" />
              <line x1="9" x2="9" y1="3" y2="18" />
              <line x1="15" x2="15" y1="6" y2="21" />
            </>
          )}
          {tab.icon === "car" && (
            <>
              <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2" />
              <circle cx="7" cy="17" r="2" />
              <path d="M9 17h6" />
              <circle cx="17" cy="17" r="2" />
            </>
          )}
          {tab.icon === "utensils" && (
            <>
              <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2" />
              <path d="M7 2v20" />
              <path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7" />
            </>
          )}
          {tab.icon === "phone" && (
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
          )}
        </svg>
        <span>{tab.label}</span>
      </a>
    ))
  }
</nav>
