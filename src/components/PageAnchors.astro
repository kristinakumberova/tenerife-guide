---
// Rychlá orientace na stránce (sticky kotvy). Port z legacy/src/components/PageAnchors.tsx.
// Statické, 0 JS — jen kotvící odkazy.
interface AnchorItem {
  href: string;
  label: string;
}

interface Props {
  items: AnchorItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <nav class="page-anchors" aria-label="Rychlá orientace na stránce">
      {items.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
  )
}
